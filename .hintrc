{
  "extends": [
    "development"
  ],
  "hints": {
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "-ms-text-size-adjust"
        ]
      }
    ],
    "button-type": "off"
  },
  "browserslist": [
    "defaults",
    "not ie 11",
    "not firefox <= 142",
    "not safari <= 18.6",
    "not and_chr <= 139",
    "not chrome <= 139",
    "not edge <= 139",
    "not samsung <= 28"
  ]
}